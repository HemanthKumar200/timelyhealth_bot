# Application
# local | production
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
# Widget demo + timelyhealth.in. Add your HTTPS chat host when deploying.
CORS_ORIGINS=https://timelyhealth.in,https://www.timelyhealth.in,http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8001,http://localhost:8001

# Ollama: do not change the model name unless you have installed it
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT_SHORT=110
OLLAMA_NUM_PREDICT_DETAILED=450

# Website synchronization
WEBSITE_BASE_URL=https://www.timelyhealth.in/
WEBSITE_PAGES_FILE=./data/website_pages.json
WEBSITE_SYNC_ENABLED=1
WEBSITE_SYNC_MINUTES=5
WEBSITE_DEEP_SYNC_ENABLED=1
WEBSITE_DEEP_SYNC_MAX_PAGES=250
WEBSITE_DEEP_SYNC_MAX_DEPTH=3
WEBSITE_USER_AGENT=TimelyHealthRAGBot/1.0
WEBSITE_REQUEST_TIMEOUT=20
WEBSITE_REQUEST_DELAY=0.5
WEBSITE_CHUNK_SIZE=850
WEBSITE_CHUNK_OVERLAP=120
WEBSITE_EMBED_BATCH_SIZE=16

# RAG storage
CHROMA_DB_PATH=./data/chroma_db
CHROMA_COLLECTION=timely_health

# API protection (widget max message length is also 500)
MAX_REQUEST_CHARS=500
RATE_LIMIT_PER_MINUTE=30

# Optional administrative secret for POST /api/sync.
# If central deployment enables HTTP sync, set a long random value.
ADMIN_SYNC_TOKEN=

# RAG
RAG_TOP_K=6
RAG_MAX_TURNS=3
RAG_MAX_CONTEXT_CHARS=5000
RAG_MAX_DISTANCE=0.68
RAG_DEBUG=0
